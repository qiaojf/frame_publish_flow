APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://video_app:video_dev_password@127.0.0.1:5432/video_platform
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_MAX_RETRIES=3
JWT_SECRET_KEY=change-this-development-secret-before-production
JWT_EXPIRE_MINUTES=120
SECRET_ENCRYPTION_KEY=change-this-separate-encryption-secret
STORAGE_TYPE=local
STORAGE_PATH=../storage
UPLOAD_MAX_SIZE_MB=10
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
GENERATION_POLL_INTERVAL=2
GENERATION_TIMEOUT=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=User123!
